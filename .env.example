# Live browser voice call. Public key is safe for client use only when restricted
# to the exact allowed origin and assistants/transient-assistant permission in Vapi.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# Optional: use a saved Vapi assistant instead of the transient assistant config.
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# Server-only. Enables provider-verified post-call duration/cost/evidence.
# Never expose this value to client-side code.
VAPI_PRIVATE_API_KEY=

# Server-only durable evidence sink. LaunchForge POSTs normalized voice events and
# provider call evidence with Authorization: Bearer <token>.
# Recommended production backing: dedicated Supabase Edge Function + Postgres table.
EVIDENCE_STORE_URL=
EVIDENCE_STORE_TOKEN=
